# Настройки языковой модели (LLM) «Патентного радара».
# Скопируйте файл в .env (cp .env.example .env) и при необходимости поменяйте значения.
# Файл .env в git не попадает (.gitignore): не храните ключи в .env.example.
# На КТ1 эндпоинт /search языковую модель не вызывает; эти настройки нужны с КТ2.
# Описание: spec/tech/architecture.md, раздел «Переключатель провайдера LLM».

# Провайдер LLM: ollama | openai_compatible | stub
#   ollama            — локальный Ollama (по умолчанию); данные не покидают компьютер.
#   openai_compatible — любой сервер с OpenAI-совместимым API: LM Studio, llama.cpp server,
#                       vLLM. Нужны LLM_BASE_URL и LLM_API_KEY.
#                       ВНИМАНИЕ: если сервер не на вашем компьютере, текст запроса уходит
#                       на этот сервер, а это нарушает принцип «данные не уходят в облако».
#                       Используйте только локальные серверы (localhost, 127.0.0.1).
#   stub              — без сети: фиксированный ответ для тестов и демонстрации без LLM.
LLM_PROVIDER=ollama

# Базовый адрес OpenAI-совместимого API, без /chat/completions на конце.
# Ollama: http://localhost:11434/v1; LM Studio: http://localhost:1234/v1.
LLM_BASE_URL=http://localhost:11434/v1

# Имя модели на сервере. Для Ollama модель сначала скачивают: ollama pull qwen2.5:7b
# (около 4,7 ГБ). Для слабого ноутбука — qwen2.5:3b.
LLM_MODEL=qwen2.5:7b

# Ключ API, уходит в заголовке Authorization: Bearer <ключ>. Ollama ключ не проверяет,
# но OpenAI-совместимые клиенты требуют непустое значение.
LLM_API_KEY=ollama

# Температура генерации от 0 до 2: чем ниже, тем меньше случайности. Для пояснений — 0.2.
LLM_TEMPERATURE=0.2

# Сколько секунд ждать ответа модели; после этого пояснение считается недоступным.
LLM_TIMEOUT_SECONDS=60
